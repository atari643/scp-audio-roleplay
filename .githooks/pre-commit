#!/bin/sh
#
# Garde-fou avant commit — ce dépôt est public.
#
# Il ne remplace pas la vigilance : il attrape les deux accidents les plus
# courants, le fichier qui n'aurait jamais dû être suivi (.env, keystore) et la
# clé collée dans le code « juste pour tester ».
#
# À activer une fois par clone :
#
#   git config core.hooksPath .githooks
#
# Pour passer outre sciemment : git commit --no-verify

bleu=''
rouge=''
neutre=''
if [ -t 2 ]; then
  rouge=$(printf '\033[31m')
  bleu=$(printf '\033[36m')
  neutre=$(printf '\033[0m')
fi

indexes=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$indexes" ] && exit 0

faute=0

# --- 1. Fichiers qui ne doivent jamais être suivis -------------------------
interdits=$(printf '%s\n' "$indexes" | grep -Ei '(^|/)\.env($|\.)|\.jks$|\.keystore$|(^|/)keystore\.properties$|(^|/)google-services\.json$|(^|/)\.vercel/')
if [ -n "$interdits" ]; then
  printf '%s\n' "${rouge}Ces fichiers ne doivent pas être commités :${neutre}" >&2
  printf '  %s\n' $interdits >&2
  printf '%s\n' "Retirez-les de l'index : ${bleu}git restore --staged <fichier>${neutre}" >&2
  faute=1
fi

# --- 2. Valeurs qui ressemblent à une clé ----------------------------------
#
# On ne regarde que les lignes AJOUTÉES, et on écarte les deux faux positifs
# connus du projet : le jeton client public d'Edge TTS, qui n'est pas un
# secret, et les fichiers d'exemple.
motifs='sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|(api[_-]?key|secret|password|passwd|token)["'"'"' ]*[:=][ ]*["'"'"'][A-Za-z0-9/+_.-]{16,}["'"'"']'

suspect=$(git diff --cached --unified=0 -- . ':(exclude)*.exemple' ':(exclude)*.example' \
  | grep -E '^\+' \
  | grep -Ev 'TRUSTED_CLIENT_TOKEN|VOTRE_CLE|<valeur|xxxx|placeholder' \
  | grep -EI "$motifs")

if [ -n "$suspect" ]; then
  printf '%s\n' "${rouge}Ces lignes ressemblent à un secret :${neutre}" >&2
  printf '%s\n' "$suspect" | head -10 >&2
  printf '%s\n' "Si c'est un faux positif : ${bleu}git commit --no-verify${neutre}" >&2
  faute=1
fi

exit $faute
