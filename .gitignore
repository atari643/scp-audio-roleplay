# ---------------------------------------------------------------------------
# Secrets — ce dépôt est PUBLIC. Rien de ce qui suit ne doit jamais être poussé.
#
# `.env*` et non `.env` : un `.env.local` ou un `.env.production` créé plus tard
# serait passé entre les mailles de l'ancienne règle.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.exemple
*.jks
*.keystore
keystore.properties

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
scripts/.build/
scripts/.audit-cache/
scripts/.probe-cache/
scripts/audit-*.json
dist-server/

# Dépendances et produits de build
node_modules/
dist/
tsconfig.tsbuildinfo
.vercel/

# Sorties audio de travail (régénérables : probe-speech.mjs, echantillons)
tmp/
tmp-ecoute/
echantillons-voix/
test_tts.mp3

# Capacitor / Android : tout ce que `npx cap sync` et Gradle régénèrent
android/app/build/
android/build/
android/.gradle/
android/.idea/
android/local.properties
android/app/src/main/assets/public/
android/capacitor-cordova-android-plugins/build/

# Outillage personnel de la machine de développement, sans rapport avec l'app
bascule/

# Réglages locaux de l'agent (permissions propres à la machine)
.claude/settings.local.json
